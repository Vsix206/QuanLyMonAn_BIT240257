@model IEnumerable<QuanLyMonAn_BIT240257.Models.DishImage_BIT240257>

@{
    ViewData["Title"] = "Manage Dish Images";

    var dish = ViewBag.Dish as
        QuanLyMonAn_BIT240257.Models.Dish_BIT240257;
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Manage Dish Images</h2>

        <a asp-controller="Dish_BIT240257"
           asp-action="Index"
           class="btn btn-secondary">
            Back to Dish List
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">
            @TempData["Success"]
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    @if (dish != null)
    {
        <div class="card mb-4">
            <div class="card-body">
                <h4>@dish.BIT240257_DishName</h4>
                <p class="mb-1">
                    <strong>Dish ID:</strong>
                    @dish.BIT240257_DishId
                </p>
                <p class="mb-0">
                    <strong>Price:</strong>
                    @dish.BIT240257_Price.ToString("N0")
                </p>
            </div>
        </div>
    }

    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0">Upload Images</h5>
        </div>

        <div class="card-body">
            <form asp-controller="DishImage_BIT240257"
                  asp-action="Upload"
                  method="post"
                  enctype="multipart/form-data">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="dishId"
                       value="@ViewBag.DishId" />

                <div class="mb-3">
                    <label for="imageFiles" class="form-label">
                        Select image files
                    </label>

                    <input type="file"
                           id="imageFiles"
                           name="imageFiles"
                           class="form-control"
                           accept=".jpg,.jpeg,.png,.webp"
                           multiple
                           required />

                    <div class="form-text">
                        Supported formats: JPG, JPEG, PNG, WEBP.
                        Maximum size: 5 MB per image.
                    </div>
                </div>

                <button type="submit" class="btn btn-primary">
                    Upload Images
                </button>
            </form>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4>Image Gallery</h4>
        <span class="badge bg-secondary">
            Total images: @Model.Count()
        </span>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No images have been uploaded for this dish.
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var image in Model)
            {
                <div class="col-12 col-sm-6 col-md-4 col-lg-3"
                     key="@image.BIT240257_ImageId">

                    <div class="card h-100 shadow-sm">
                        <img src="@image.BIT240257_ImageUrl"
                             alt="Dish image @image.BIT240257_ImageId"
                             class="card-img-top"
                             style="height:200px; object-fit:cover;" />

                        <div class="card-body d-flex flex-column">
                            <p class="text-muted small">
                                Image ID: @image.BIT240257_ImageId
                            </p>

                            @if (image.IsThumbnail)
                            {
                                <span class="badge bg-success mb-3">
                                    Current Thumbnail
                                </span>
                            }
                            else
                            {
                                <form asp-controller="DishImage_BIT240257"
                                      asp-action="SetThumbnail"
                                      method="post"
                                      class="mb-2">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="imageId"
                                           value="@image.BIT240257_ImageId" />

                                    <button type="submit"
                                            class="btn btn-outline-success btn-sm w-100">
                                        Set as Thumbnail
                                    </button>
                                </form>
                            }

                            <form asp-controller="DishImage_BIT240257"
                                  asp-action="Delete"
                                  method="post"
                                  onsubmit="return confirm('Are you sure you want to delete this image?');"
                                  class="mt-auto">

                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="imageId"
                                       value="@image.BIT240257_ImageId" />

                                <button type="submit"
                                        class="btn btn-danger btn-sm w-100">
                                    Delete Image
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
