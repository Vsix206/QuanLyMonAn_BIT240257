
@model IEnumerable<QuanLyMonAn_BIT240257.Models.Dish_BIT240257>

@{
    ViewData["Title"] = "Quản lý món ăn";
}

<div class="container mt-4 mb-5">

    <!-- Tiêu đề và nút thêm món ăn -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Quản lý món ăn</h2>

        <a asp-controller="Dish_BIT240257"
           asp-action="Create"
           class="btn btn-success">
            + Thêm món ăn
        </a>
    </div>

    <!-- Form tìm kiếm và lọc món ăn -->
    <form asp-controller="Dish_BIT240257"
          asp-action="Index"
          method="get"
          class="row g-3 mb-4">

        <!-- Tìm kiếm theo tên -->
        <div class="col-md-4">
            <label class="form-label">Tên món ăn</label>
            <input type="text"
                   name="searchString"
                   value="@ViewBag.CurrentFilter"
                   class="form-control"
                   placeholder="Nhập tên món ăn..." />
        </div>

        <!-- Lọc theo danh mục -->
        <div class="col-md-3">
            <label class="form-label">Danh mục</label>
            <select name="categoryId" class="form-select">
                <option value="">Tất cả danh mục</option>

                @if (ViewBag.Categories != null)
                {
                    @foreach (var category in ViewBag.Categories)
                    {
                        <option value="@category.BIT240257_CategoryId"
                                selected="@(ViewBag.CurrentCategory != null &&
                                    (int)ViewBag.CurrentCategory ==
                                    category.BIT240257_CategoryId)">
                            @category.BIT240257_CategoryName
                        </option>
                    }
                }
            </select>
        </div>

        <!-- Giá tối thiểu -->
        <div class="col-md-2">
            <label class="form-label">Giá từ (VNĐ)</label>
            <input type="number"
                   name="minPrice"
                   value="@ViewBag.MinPrice"
                   min="0"
                   step="1000"
                   class="form-control"
                   placeholder="Giá thấp nhất" />
        </div>

        <!-- Giá tối đa -->
        <div class="col-md-3">
            <label class="form-label">Giá đến (VNĐ)</label>
            <input type="number"
                   name="maxPrice"
                   value="@ViewBag.MaxPrice"
                   min="0"
                   step="1000"
                   class="form-control"
                   placeholder="Giá cao nhất" />
        </div>

        <!-- Nút tìm kiếm -->
        <div class="col-12">
            <button type="submit" class="btn btn-primary">
                Tìm kiếm và lọc
            </button>

            <a asp-controller="Dish_BIT240257"
               asp-action="Index"
               class="btn btn-secondary">
                Xóa bộ lọc
            </a>
        </div>
    </form>

    <!-- Bảng danh sách món ăn -->
    <div class="table-responsive">
        <table class="table table-bordered table-striped table-hover align-middle">

            <thead class="table-dark">
                <tr>
                    <th>Mã món</th>
                    <th>Tên món ăn</th>
                    <th>Giá</th>
                    <th>Mô tả</th>
                    <th>Hình ảnh</th>
                    <th>Danh mục</th>
                    <th style="min-width: 280px;">Chức năng</th>
                </tr>
            </thead>

            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.BIT240257_DishId</td>

                            <td>
                                <strong>@item.BIT240257_DishName</strong>
                            </td>

                            <td>
                                @item.BIT240257_Price.ToString("N0") VNĐ
                            </td>

                            <td>
                                @item.BIT240257_Description
                            </td>

                            <!-- Hình ảnh đại diện -->
                            <td>
                                @if (!string.IsNullOrWhiteSpace(item.BIT240257_ImageUrl))
                                {
                                    <img src="@item.BIT240257_ImageUrl"
                                         alt="@item.BIT240257_DishName"
                                         style="width:100px;height:75px;object-fit:cover;"
                                         class="rounded" />
                                }
                                else
                                {
                                    <span class="text-muted">Chưa có ảnh</span>
                                }
                            </td>

                            <!-- Danh mục -->
                            <td>
                                @(item.Category?.BIT240257_CategoryName
                                    ?? "Chưa phân loại")
                            </td>

                            <!-- Các chức năng -->
                            <td>
                                <div class="d-flex flex-wrap gap-1">

                                    <a asp-controller="Dish_BIT240257"
                                       asp-action="Details"
                                       asp-route-id="@item.BIT240257_DishId"
                                       class="btn btn-info btn-sm">
                                        Chi tiết
                                    </a>

                                    <a asp-controller="Dish_BIT240257"
                                       asp-action="Edit"
                                       asp-route-id="@item.BIT240257_DishId"
                                       class="btn btn-warning btn-sm">
                                        Sửa
                                    </a>

                                    <a asp-controller="Dish_BIT240257"
                                       asp-action="Delete"
                                       asp-route-id="@item.BIT240257_DishId"
                                       class="btn btn-danger btn-sm">
                                        Xóa
                                    </a>

                                    <a asp-controller="DishImage_BIT240257"
                                       asp-action="Index"
                                       asp-route-dishId="@item.BIT240257_DishId"
                                       class="btn btn-primary btn-sm">
                                        Quản lý hình ảnh
                                    </a>

                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-4">
                            <span class="text-muted">
                                Không tìm thấy món ăn phù hợp.
                            </span>
                        </td>
                    </tr>
                }
            </tbody>

        </table>
    </div>

    <!-- Tổng số món ăn đang hiển thị -->
    <div class="mt-3">
        <strong>Số món ăn tìm thấy:</strong> @Model.Count()
    </div>

</div>
