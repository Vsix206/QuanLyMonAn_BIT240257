@model QuanLyMonAn_BIT240257.Models.DishCategory_BIT240257

@{
    ViewData["Title"] = "Thêm danh mục";
}

<div class="container mt-4 mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-primary text-white py-3">
                    <h3 class="mb-0">THÊM DANH MỤC MÓN ĂN</h3>
                </div>

                <div class="card-body p-4">
                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="BIT240257_CategoryName"
                                   class="form-label">
                                Tên danh mục
                            </label>

                            <input asp-for="BIT240257_CategoryName"
                                   class="form-control"
                                   placeholder="Ví dụ: Món chính" />

                            <span asp-validation-for="BIT240257_CategoryName"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="BIT240257_Description"
                                   class="form-label">
                                Mô tả danh mục
                            </label>

                            <textarea asp-for="BIT240257_Description"
                                      class="form-control"
                                      rows="4"
                                      placeholder="Nhập mô tả cho danh mục..."></textarea>

                            <span asp-validation-for="BIT240257_Description"
                                  class="text-danger"></span>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit"
                                    class="btn btn-primary">
                                Lưu danh mục
                            </button>

                            <a asp-action="Index"
                               class="btn btn-outline-secondary">
                                Quay lại danh sách
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}