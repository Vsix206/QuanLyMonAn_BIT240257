@model IEnumerable<QuanLyMonAn_BIT240257.Models.DishCategory_BIT240257>

@{
    ViewData["Title"] = "Quản lý danh mục";
}

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="text-primary fw-bold">QUẢN LÝ DANH MỤC MÓN ĂN</h2>
            <p class="text-muted mb-0">
                Danh sách các danh mục món ăn trong hệ thống
            </p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            + Thêm danh mục
        </a>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th style="width:100px">Mã danh mục</th>
                            <th>Tên danh mục</th>
                            <th>Mô tả</th>
                            <th style="width:120px">Số món ăn</th>
                            <th style="width:200px">Thao tác</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.BIT240257_CategoryId</td>
                                    <td class="fw-semibold">
                                        @item.BIT240257_CategoryName
                                    </td>
                                    <td>
                                        @item.BIT240257_Description
                                    </td>
                                    <td class="text-center">
                                        @(item.Dishes?.Count ?? 0)
                                    </td>
                                    <td class="text-nowrap">
                                        <a asp-action="Details"
                                           asp-route-id="@item.BIT240257_CategoryId"
                                           class="btn btn-sm btn-info text-white">
                                            Chi tiết
                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-id="@item.BIT240257_CategoryId"
                                           class="btn btn-sm btn-warning">
                                            Sửa
                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@item.BIT240257_CategoryId"
                                           class="btn btn-sm btn-danger">
                                            Xóa
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5"
                                    class="text-center py-4 text-muted">
                                    Chưa có danh mục nào.
                                    Hãy nhấn "Thêm danh mục" để bắt đầu.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="mt-3">
        <a asp-controller="Dish_BIT240257"
           asp-action="Index"
           class="btn btn-outline-secondary">
            ← Quay lại danh sách món ăn
        </a>
    </div>
</div>